{
    "version": 2,
    "builds": [
        {
            "src": "api.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api.py"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "gym_api.settings",
        "PYTHONPATH": ".",
        "PIP_BREAK_SYSTEM_PACKAGES": "1"
    }
}