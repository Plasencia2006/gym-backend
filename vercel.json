{
    "version": 2,
    "builds": [
        {
            "src": "build.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles"
            }
        },
        {
            "src": "api.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "api.py"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "gym_api.settings",
        "PYTHONPATH": ".",
        "PIP_BREAK_SYSTEM_PACKAGES": "1"
    }
}